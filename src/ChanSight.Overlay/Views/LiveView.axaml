<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChanSight.Overlay.ViewModels"
             xmlns:prim="using:Avalonia.Controls.Primitives"
             x:Class="ChanSight.Overlay.Views.LiveView"
             x:DataType="vm:LiveViewModel">
    <ScrollViewer Background="{StaticResource PageBackground}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12">

            <!-- ================= 赛季 / 模式选择器 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentGold}" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="赛季 / 模式" Classes="cardTitle" />
                            <TextBlock Text="切换即时生效 · 字典按赛季、prompt/算法按模式变化" Classes="muted" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="赛季" Classes="subtle" />
                            <ComboBox ItemsSource="{Binding SeasonOptions}"
                                      SelectedItem="{Binding SelectedSeason}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="模式" Classes="subtle" />
                            <ComboBox ItemsSource="{Binding ModeOptions}"
                                      SelectedItem="{Binding SelectedMode}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 状态卡 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentGold}" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="对局状态" Classes="cardTitle" />
                            <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                        <Border Grid.Column="0" Classes="cardRaised" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="金币" Classes="statLabel" />
                                <TextBlock Text="{Binding Gold}" Classes="statValue" Foreground="{StaticResource AccentGold}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="cardRaised" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="等级" Classes="statLabel" />
                                <TextBlock Text="{Binding Level}" Classes="statValue" Foreground="{StaticResource AccentBlue}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Classes="cardRaised" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="阶段" Classes="statLabel" />
                                <TextBlock Text="{Binding Stage}" Classes="statValue" Foreground="{StaticResource AccentPurple}" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Classes="cardRaised" Padding="10,8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="血量" Classes="statLabel" />
                                <TextBlock Text="{Binding Hp}" Classes="statValue" Foreground="{StaticResource AccentRed}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= 手动 VLM 识别 + 数据健康度 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentGreen}" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="手动整帧 VLM 识别" Classes="cardTitle" />
                            <TextBlock Text="自动识别不准时手动兜底 · 识别结果写入状态并标记健康度" Classes="muted" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="数据健康度:" Classes="subtle" VerticalAlignment="Center" />
                        <Border Background="{StaticResource AccentGreen}" CornerRadius="4" Padding="8,2">
                            <TextBlock Text="{Binding HealthLabel}" FontWeight="Bold" Foreground="#0B1F18" />
                        </Border>
                        <TextBlock Classes="subtle" VerticalAlignment="Center"
                                   IsVisible="{Binding IsUncalibrated}"
                                   Text="⚠ 数据未校准" />
                    </StackPanel>

                    <WrapPanel>
                        <Button Content="识别己方" Classes="accent" Command="{Binding ManualRecognizeSelfCommand}" Margin="0,0,8,0" />
                        <Button Content="识别对手" Classes="ghost" Command="{Binding ManualRecognizeOpponentCommand}" Margin="0,0,8,0" />
                    </WrapPanel>

                    <!-- 对手序号确认 -->
                    <Border Classes="cardRaised" IsVisible="{Binding HasOpponentInfo}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding OpponentInfo}" Classes="subtle" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="对手序号" Classes="subtle" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding OpponentIndexOptions}"
                                          SelectedIndex="{Binding OpponentIndex}" />
                                <Button Grid.Column="2" Content="确认写入" Classes="accent"
                                        Command="{Binding ConfirmOpponentCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= 对手信息(折叠卡, 默认折叠, 避免与己方棋盘/备战席并排成两行) ================= -->
            <Border Classes="card"
                    IsVisible="{Binding HasOpponentInfo}"
                    BorderBrush="{StaticResource AccentRed}"
                    Background="{StaticResource AccentRedDim}">
                <Expander IsExpanded="False">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="4" CornerRadius="2" Background="{StaticResource AccentRed}" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="对手 · 棋盘 / 备战席" Classes="cardTitle" Foreground="{StaticResource AccentRed}" />
                                <TextBlock Text="{Binding OpponentInfo}" Classes="muted" />
                            </StackPanel>
                        </StackPanel>
                    </Expander.Header>

                    <StackPanel Spacing="10">
                        <TextBlock Text="对手棋盘" Classes="subtle" />
                        <ItemsControl ItemsSource="{Binding OpponentBoardCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SlotDisplay">
                                    <Border Classes="slot"
                                            Classes.empty="{Binding IsEmpty}"
                                            Width="64" Height="40" Padding="2" Margin="0,0,4,4">
                                        <StackPanel Spacing="0">
                                            <TextBlock Text="{Binding DisplayText}" Classes="slotName" FontSize="9"
                                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="10" />
                                            <TextBlock Text="{Binding ItemsText}" Classes="muted" FontSize="8"
                                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="8" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="对手备战席" Classes="subtle" />
                        <ItemsControl ItemsSource="{Binding OpponentBenchCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SlotDisplay">
                                    <Border Classes="slot"
                                            Classes.empty="{Binding IsEmpty}"
                                            Width="64" Height="40" Padding="2" Margin="0,0,4,4">
                                        <StackPanel Spacing="0">
                                            <TextBlock Text="{Binding DisplayText}" Classes="slotName" FontSize="9"
                                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="10" />
                                            <TextBlock Text="{Binding ItemsText}" Classes="muted" FontSize="8"
                                                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" LineHeight="8" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </Border>

            <!-- ================= 棋盘卡: 4×7 六角网格 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentBlue}" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="棋盘 · 28" Classes="cardTitle" />
                            <TextBlock Text="4×7 六角网格 · 交错排列(奇数行右移半格)" Classes="muted" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding BoardCells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="578" Height="196" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerTheme>
                            <ControlTheme TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{ReflectionBinding HexX}" />
                                <Setter Property="Canvas.Top" Value="{ReflectionBinding HexY}" />
                            </ControlTheme>
                        </ItemsControl.ItemContainerTheme>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SlotDisplay">
                                <Border Classes="slot"
                                        Classes.empty="{Binding IsEmpty}"
                                        Classes.corrected="{Binding HasCorrection}"
                                        Width="68" Height="54" Padding="3">
                                    <StackPanel Spacing="0">
                                        <TextBlock Text="{Binding DisplayText}"
                                                   Classes="slotName"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   LineHeight="12" />
                                        <TextBlock Text="{Binding ItemsText}"
                                                   Classes="muted"
                                                   FontSize="9"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   LineHeight="9" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= 备战席条: 9 格横排 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentPurple}" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="备战席 · 9" Classes="cardTitle" />
                            <TextBlock Text="横向条状布局" Classes="muted" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding BenchCells}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <prim:UniformGrid Columns="9" ColumnSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SlotDisplay">
                                <Border Classes="slot"
                                        Classes.empty="{Binding IsEmpty}"
                                        Classes.corrected="{Binding HasCorrection}"
                                        Height="52" Padding="4">
                                    <TextBlock Text="{Binding DisplayText}"
                                               Classes="slotName"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               LineHeight="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= 商店条: 5 格横排 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentRed}" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="商店 · 5" Classes="cardTitle" />
                            <TextBlock Text="横向条状布局 · 显示费用" Classes="muted" />
                        </StackPanel>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding ShopCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <prim:UniformGrid Columns="5" ColumnSpacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SlotDisplay">
                                <Border Classes="slot"
                                        Classes.empty="{Binding IsEmpty}"
                                        Classes.corrected="{Binding HasCorrection}"
                                        Height="58" Padding="6">
                                    <TextBlock Text="{Binding DisplayText}"
                                               Classes="slotName"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               LineHeight="12" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================= 修正卡 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentGreen}" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="钉帧修正" Classes="cardTitle" />
                            <TextBlock Text="钉住当前帧后逐格修正, 支持英雄/星级/标记为空" Classes="muted" />
                        </StackPanel>
                    </StackPanel>

                    <WrapPanel>
                        <Button Content="🔒 钉帧" Classes="accent" Command="{Binding EnterPinCommand}" Margin="0,0,8,0" />
                        <Button Content="取消钉帧" Classes="ghost" Command="{Binding CancelPinCommand}" IsEnabled="{Binding IsPinned}" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding PinnedFrameId, StringFormat='钉住的帧: {0}'}" Classes="subtle" VerticalAlignment="Center" />
                    </WrapPanel>

                    <Border Classes="cardRaised" IsVisible="{Binding IsPinned}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="修正区域" Classes="subtle" />
                            <ComboBox ItemsSource="{Binding CellRegionTypes}" SelectedIndex="{Binding SelectedRegionTypeIndex}" />

                            <Grid ColumnDefinitions="Auto,*,32,Auto,*" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="格序号" Classes="subtle" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="1" Minimum="0" Maximum="27" Value="{Binding SelectedCellIndex}" />
                                <TextBlock Grid.Column="3" Text="星级" Classes="subtle" VerticalAlignment="Center" />
                                <NumericUpDown Grid.Column="4" Minimum="0" Maximum="3" Value="{Binding SelectedStar}" />
                            </Grid>

                            <TextBlock Text="英雄候选" Classes="subtle" />
                            <ComboBox ItemsSource="{Binding HeroCandidates}" SelectedItem="{Binding SelectedHero}" />

                            <WrapPanel>
                                <Button Content="确认英雄" Classes="accent" Command="{Binding CommitHeroCommand}" Margin="0,0,8,0" />
                                <Button Content="确认星级" Classes="ghost" Command="{Binding CommitStarCommand}" Margin="0,0,8,0" />
                                <Button Content="标记为空" Classes="danger" Command="{Binding CommitEmptyCommand}" />
                            </WrapPanel>

                            <Separator />

                            <TextBlock Text="装备修正(棋盘格, 逗号分隔)" Classes="subtle" />
                            <TextBox Text="{Binding SelectedItems}" Watermark="如 羊刀,狂徒铠甲" />
                            <WrapPanel>
                                <Button Content="确认装备" Classes="ghost" Command="{Binding CommitItemsCommand}" />
                                <ComboBox ItemsSource="{Binding ItemCandidates}" SelectedItem="{Binding SelectedItems}"
                                          MinWidth="160" Margin="8,0,0,0" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ================= 双轨推荐卡 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentGold}" />
                        <StackPanel Spacing="1">
                            <TextBlock Text="双轨推荐" Classes="cardTitle" />
                            <TextBlock Text="算法(数据更新自动) + LLM(手动触发) · 来源明确标注" Classes="muted" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 健康度未校准警告条 -->
                    <Border Classes="cardRaised" IsVisible="{Binding IsStale}"
                            Background="#3A2A0A" Padding="10,6">
                        <TextBlock Text="{Binding StaleWarning}" FontWeight="Bold" Foreground="#FFD34D" TextWrapping="Wrap" />
                    </Border>

                    <WrapPanel>
                        <Button Content="↻ 刷新算法" Classes="accent" Command="{Binding RefreshAlgorithmCommand}" Margin="0,0,8,0" />
                        <Button Content="🤖 请求 LLM 建议" Classes="ghost" Command="{Binding RequestLlmAdviceCommand}" />
                    </WrapPanel>

                    <!-- 算法推荐列表 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="算法推荐" Classes="subtle" FontWeight="Bold" />
                        <ListBox ItemsSource="{Binding AlgorithmRecommendations}" MinHeight="100" Background="Transparent" BorderThickness="0"
                                 Opacity="{Binding RecommendationOpacity}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecommendationDisplay">
                                    <Border Classes="cardRaised" Padding="10,6" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{StaticResource AccentBlue}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SourceTag}" FontSize="10" FontWeight="Bold" Foreground="#0B1F18" />
                                            </Border>
                                            <Border Background="{StaticResource AccentGreen}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Verdict}" FontSize="11" FontWeight="Bold" Foreground="#0B1F18" />
                                            </Border>
                                            <TextBlock Text="{Binding Reason}" Classes="subtle" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Priority, StringFormat='P{0}'}" Classes="muted" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding GeneratedAt, StringFormat='{}{0:HH:mm:ss}'}" Classes="muted" VerticalAlignment="Center" FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <!-- LLM 推荐单条 -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="LLM 推荐(手动, 缓存最近 1 条)" Classes="subtle" FontWeight="Bold" />
                        <Border Classes="cardRaised" Padding="10,6"
                                IsVisible="{Binding HasLlmAdvice}">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border Background="{StaticResource AccentPurple}" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LlmAdvice.SourceTag}" FontSize="10" FontWeight="Bold" Foreground="#0B1F18" />
                                    </Border>
                                    <TextBlock Text="{Binding LlmAdvice.Confidence, StringFormat='置信度 {0:P0}'}" Classes="muted" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding LlmAdvice.GeneratedAt, StringFormat='{}{0:HH:mm:ss}'}" Classes="muted" VerticalAlignment="Center" FontSize="10" />
                                </StackPanel>
                                <TextBlock Text="{Binding LlmAdvice.Suggestion}" FontWeight="Bold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LlmAdvice.Reason}" Classes="subtle" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="尚未请求 LLM 建议。" Classes="muted" IsVisible="{Binding HasNoLlmAdvice}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>