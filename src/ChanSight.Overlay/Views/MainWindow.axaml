<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChanSight.Overlay.ViewModels"
        x:Class="ChanSight.Overlay.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="ChanSight"
        Width="520"
        Height="860"
        MinWidth="360"
        MinHeight="560">
    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding ToggleLabel}" Command="{Binding ToggleModeCommand}" />
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <ContentControl Name="Host" />
    </DockPanel>
</Window>