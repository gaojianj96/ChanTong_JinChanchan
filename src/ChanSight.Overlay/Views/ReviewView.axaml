<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChanSight.Overlay.ViewModels"
             xmlns:core="using:ChanSight.Core.FrameStorage"
             xmlns:prim="using:Avalonia.Controls.Primitives"
             x:Class="ChanSight.Overlay.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">
    <ScrollViewer Background="{StaticResource PageBackground}"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16" Spacing="12">

            <!-- ================= 回顾状态卡 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentBlue}" />
                        <TextBlock Text="回顾模式" Classes="cardTitle" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" Classes="subtle" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="对局 ID" Classes="subtle" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding MatchIdOptions}"
                                  SelectedItem="{Binding MatchId}"
                                  Text="{Binding MatchId}"
                                  IsEditable="True"
                                  Width="160" />
                        <Button Content="刷新" Classes="ghost" Command="{Binding RefreshMatchesCommand}" />
                        <Button Content="加载关键帧" Classes="accent" Command="{Binding LoadFramesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ================= 关键帧列表卡 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentPurple}" />
                        <TextBlock Text="关键帧" Classes="cardTitle" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding KeyFrames}" SelectedItem="{Binding SelectedFrame}" MinHeight="60" MaxHeight="150">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="core:FrameKey">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding FrameId}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding SnapshotVersion, StringFormat='v{0}'}" Classes="muted" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ================= 原图 + 格框叠加卡(可缩放/平移) ================= -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentRed}" />
                        <TextBlock Text="原图 + 格框叠加" Classes="cardTitle" />
                        <Button Content="−" Classes="ghost" Command="{Binding ZoomOutCommand}" />
                        <Button Content="+" Classes="ghost" Command="{Binding ZoomInCommand}" />
                        <Button Content="重置" Classes="ghost" Command="{Binding ResetZoomCommand}" />
                        <TextBlock Text="{Binding Zoom, StringFormat='{}{0:P0}'}" Classes="muted" VerticalAlignment="Center" />
                        <TextBlock Text="滚轮缩放 · 拖拽平移" Classes="muted" VerticalAlignment="Center" />
                    </StackPanel>

                    <ScrollViewer Name="ImageScroll"
                                  Classes="cardRaised"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="520"
                                  PointerPressed="OnImagePointerPressed"
                                  PointerMoved="OnImagePointerMoved"
                                  PointerReleased="OnImagePointerReleased"
                                  PointerCaptureLost="OnImagePointerCaptureLost">
                        <Border Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                            <Panel Width="{Binding RenderWidth}" Height="{Binding RenderHeight}"
                                   HorizontalAlignment="Left" VerticalAlignment="Top"
                                   RenderTransformOrigin="0,0"
                                   PointerWheelChanged="OnImagePointerWheelChanged">
                                <Panel.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                                </Panel.RenderTransform>
                                <Image Source="{Binding FrameBitmap}" Stretch="Fill" />
                                <ItemsControl ItemsSource="{Binding Boxes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReviewBoxDisplay">
                                            <Border Canvas.Left="{Binding X}"
                                                    Canvas.Top="{Binding Y}"
                                                    Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    BorderBrush="{StaticResource AccentRed}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="3"
                                                    Background="#22F26D6D">
                                                <TextBlock Text="{Binding Label}" FontSize="8" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Panel>
                        </Border>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= 棋盘 4×7 + 悬停 tooltip 卡 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentGold}" />
                        <TextBlock Text="棋盘 · 4×7" Classes="cardTitle" />
                        <TextBlock Text="悬停查看详情 · 点击选中修正" Classes="muted" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding BoardCells}" SelectedItem="{Binding SelectedCell}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <prim:UniformGrid Columns="7" Rows="4" ColumnSpacing="4" RowSpacing="4" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewCellDisplay">
                                <Border Classes="cardRaised" Padding="4" CornerRadius="4"
                                        BorderBrush="{StaticResource AccentBlue}" BorderThickness="1"
                                        ToolTip.Tip="{Binding ToolTipText}">
                                    <TextBlock Text="{Binding ShortLabel}" FontSize="11"
                                               TextAlignment="Center" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="备战席 / 商店" Classes="subtle" />
                    <ListBox ItemsSource="{Binding SideCells}" SelectedItem="{Binding SelectedCell}" MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewCellDisplay">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Border Background="{StaticResource AccentBlueDim}" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="{Binding KindLabel}" Classes="muted" />
                                    </Border>
                                    <TextBlock Text="{Binding DisplayText}" FontWeight="Medium" />
                                    <TextBlock Text="{Binding SourceTier}" Foreground="{StaticResource AccentBlue}" />
                                    <TextBlock Text="{Binding Star, StringFormat='★{0}'}" FontSize="11" Foreground="{StaticResource AccentGold}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ================= 修正控件卡 ================= -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource AccentGreen}" />
                        <TextBlock Text="修正控件" Classes="cardTitle" />
                    </StackPanel>

                    <Border Classes="cardRaised">
                        <StackPanel Spacing="8">
                            <TextBlock Text="修正类型" Classes="subtle" />
                            <ComboBox ItemsSource="{Binding CorrectionTypeOptions}" SelectedIndex="{Binding SelectedCorrectionTypeIndex}" />
                            <TextBlock Text="英雄候选" Classes="subtle" />
                            <ComboBox ItemsSource="{Binding HeroCandidates}" SelectedItem="{Binding SelectedHero}" />
                            <WrapPanel>
                                <Button Content="确认英雄" Classes="accent" Command="{Binding ApplyCorrectionCommand}" Margin="0,0,8,0" />
                                <Button Content="标记为空" Classes="danger" Command="{Binding MarkEmptyCommand}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Button Content="✓ 确认本帧" Classes="accent" Command="{Binding ConfirmFrameCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="未修正格将在确认时自动生成 confirm-correct 金标(默认正确)。" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>