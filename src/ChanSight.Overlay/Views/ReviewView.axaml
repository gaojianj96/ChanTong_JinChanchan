<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChanSight.Overlay.ViewModels"
             xmlns:core="using:ChanSight.Core.FrameStorage"
             x:Class="ChanSight.Overlay.Views.ReviewView"
             x:DataType="vm:ReviewViewModel">
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="8">

            <TextBlock Text="{Binding Status}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />

            <WrapPanel>
                <TextBlock Text="对局 ID" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Text="{Binding MatchId}" Width="120" Margin="0,0,6,0" />
                <Button Content="加载关键帧" Command="{Binding LoadFramesCommand}" />
            </WrapPanel>

            <TextBlock Text="关键帧" FontWeight="Bold" />
            <ListBox ItemsSource="{Binding KeyFrames}" SelectedItem="{Binding SelectedFrame}" MinHeight="60" MaxHeight="140">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:FrameKey">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding FrameId}" />
                            <TextBlock Text="{Binding SnapshotVersion, StringFormat='v{0}'}" Foreground="Gray" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="原图 + 格框叠加" FontWeight="Bold" />
            <Border BorderBrush="Gray" BorderThickness="1" HorizontalAlignment="Left">
                <Panel Width="{Binding RenderWidth}" Height="{Binding RenderHeight}">
                    <Image Source="{Binding FrameBitmap}" Stretch="Fill" />
                    <ItemsControl ItemsSource="{Binding Boxes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ReviewBoxDisplay">
                                <Border Canvas.Left="{Binding X}"
                                        Canvas.Top="{Binding Y}"
                                        Width="{Binding Width}"
                                        Height="{Binding Height}"
                                        BorderBrush="Red"
                                        BorderThickness="1"
                                        Background="#22FF0000">
                                    <TextBlock Text="{Binding Label}" FontSize="8" Foreground="Yellow" VerticalAlignment="Top" HorizontalAlignment="Left" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Panel>
            </Border>

            <TextBlock Text="格数据列表(逐格校验)" FontWeight="Bold" />
            <ListBox ItemsSource="{Binding Cells}" SelectedItem="{Binding SelectedCell}" MaxHeight="260">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReviewCellDisplay">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding KindLabel}" Foreground="Gray" />
                            <TextBlock Text="{Binding DisplayText}" />
                            <TextBlock Text="{Binding SourceTier}" Foreground="SteelBlue" />
                            <TextBlock Text="{Binding Star, StringFormat='★{0}'}" FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="修正控件" FontWeight="Bold" />
            <StackPanel Spacing="4">
                <TextBlock Text="修正类型" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding CorrectionTypeOptions}" SelectedIndex="{Binding SelectedCorrectionTypeIndex}" />
                <TextBlock Text="英雄候选" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding HeroCandidates}" SelectedItem="{Binding SelectedHero}" />
                <WrapPanel>
                    <Button Content="确认英雄" Command="{Binding ApplyCorrectionCommand}" Margin="0,0,8,0" />
                    <Button Content="标记为空" Command="{Binding MarkEmptyCommand}" />
                </WrapPanel>
            </StackPanel>

            <Separator />

            <Button Content="确认本帧" Command="{Binding ConfirmFrameCommand}" FontSize="14" />
            <TextBlock Text="未修正格将在确认时自动生成 confirm-correct 金标(默认正确)。" FontSize="11" Foreground="Gray" TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>